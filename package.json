{
  "name": "kb-1-daemon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "check": "node scripts/check.mjs",
    "docker:down": "docker compose down",
    "docker:up": "node scripts/docker-up.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:daemon": "pnpm --filter @kb-1/daemon dev",
    "dev:web": "pnpm --filter @kb-1/web dev",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "smoke:release": "node scripts/release-smoke.mjs",
    "smoke:windows": "node scripts/windows-smoke.mjs",
    "smoke:yjs": "node scripts/yjs-smoke.mjs",
    "storybook": "pnpm --filter @kb-1/ui storybook",
    "test": "pnpm test:scripts && nx run-many -t test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/ws": "8.18.1",
    "@types/node": "26.2.0",
    "lib0": "0.2.117",
    "nx": "23.1.1",
    "tsx": "4.23.11",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "ws": "8.21.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  }
}
