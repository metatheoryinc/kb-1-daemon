{
  "name": "kb-2",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.3",
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "check": "node scripts/check.mjs",
    "docker:down": "docker compose down",
    "docker:up": "docker compose up --build -d daemon",
    "dev": "node scripts/dev.mjs",
    "dev:daemon": "pnpm --filter @kb-2/daemon dev",
    "dev:tunnel-client-spike": "pnpm --filter @kb-2/tunnel-client-spike dev",
    "dev:web": "pnpm --filter @kb-2/web dev",
    "smoke:yjs": "node scripts/yjs-smoke.mjs",
    "storybook": "pnpm --filter @kb-2/ui storybook",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "@types/node": "25.9.2",
    "lib0": "0.2.117",
    "nx": "22.7.5",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "ws": "8.21.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  }
}
