{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "daemon",
  "sourceRoot": "apps/daemon/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/daemon build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/daemon dev"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/daemon test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/daemon typecheck"
      }
    }
  }
}
