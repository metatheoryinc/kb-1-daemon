{
  "name": "@kb-1/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kb1d": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/main.js', 0o755)\" && node scripts/bundle-starter-kit.mjs",
    "dev": "tsx src/main.ts",
    "test": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@kb-1/doc-session": "workspace:*",
    "@kb-1/local-mcp": "workspace:*",
    "@kb-1/tunnel-client": "workspace:*",
    "@kb-1/vault-core": "workspace:*",
    "@kb-1/vault-service": "workspace:*",
    "github-slugger": "2.0.0",
    "hono": "4.13.5",
    "yazl": "3.3.1",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "4.1.8",
    "yauzl": "3.4.0",
    "yjs": "13.6.32"
  }
}
