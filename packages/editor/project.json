{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "editor",
  "sourceRoot": "packages/editor/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/editor build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/editor test"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm --filter @kb-1/editor typecheck"
      }
    }
  }
}

